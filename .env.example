# =============================================================================================
# AnsibleForms environment variables : an example
# =============================================================================================
#
# Copy this file to where your setup reads its variables and fill in your own values :
#   - local development : server/.env.development (NODE_ENV=development, see CONTRIBUTING.md)
#   - docker compose     : the .env file next to compose.yaml (env_file: .env), NODE_ENV=production
# Never commit the copy : .env files are ignored by git. Every value below is a placeholder.
#
# This lists the main variables only. Every variable, with its default and what it does, is in
# the app under Help > Environment Variables (server/help.yaml) and on
# https://ansibleforms.com/customization/ ; the RTE's in https://ansibleforms.com/rte/modes.html
# A variable commented out keeps its default.

# ---------------------------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------------------------

# production (the default) or development ; only outside production does the server read
# server/.env.<NODE_ENV> itself
NODE_ENV=development
# the port the web application listens on
PORT=8443
# 1 : serve HTTPS with the key and certificate below (default : certificates/ in the persistent
# folder) ; 0 : plain HTTP, behind a reverse proxy or a load balancer that does TLS
HTTPS=1
# HTTPS_KEY=/path/to/persistent/certificates/key.pem
# HTTPS_CERT=/path/to/persistent/certificates/cert.pem
# host the app under a url subpath, for example behind a reverse proxy
# BASE_URL=/ansibleforms
# behind a reverse proxy : which proxies may report the client's address (X-Forwarded-For)
# TRUST_PROXY=1

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------

# a user with all rights on the AnsibleForms schema and none elsewhere, not root
DB_HOST=db.example.com
DB_PORT=3306
DB_USER=ansibleforms
DB_PASSWORD=change-me

# a backup of the database is taken before an upgrade patches it ; 0 upgrades without one
# UPGRADE_BACKUP=1
# BACKUP_PATH=/path/to/persistent/backups

# ---------------------------------------------------------------------------------------------
# Secrets and the first admin
# ---------------------------------------------------------------------------------------------

# signs the sign-in tokens : the same on every app node, a long random string
ACCESS_TOKEN_SECRET=change-me-a-long-random-string
# ACCESS_TOKEN_EXPIRATION=30m
# encrypts the passwords and tokens stored in the database : the same on every container, and
# never lost (without it they are unreadable). Not set : a default key, public in the source
ENCRYPTION_SECRET=change-me-a-long-random-string-too
# the local admin account a new install creates (the default password must be changed at the
# first sign-in)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-admin-password
# sign-in requests a minute from one address, per app node ; 0 turns the limit off
# AUTH_RATE_LIMIT=120

# ---------------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------------

# emerg, alert, crit, error, warning, notice, info or debug
# LOG_LEVEL=notice
# LOG_CONSOLE_LEVEL=notice
# LOG_PATH=/path/to/persistent/logs

# ---------------------------------------------------------------------------------------------
# Paths and configuration
# ---------------------------------------------------------------------------------------------

# the root folder of your playbooks
# ANSIBLE_PATH=/path/to/persistent/playbooks
# a declarative config seed applied at every start (https://ansibleforms.com/seed/)
# CONFIG_SEED_PATH=/path/to/seed.yaml
# what this process runs : unset (the web app and the worker), app, worker or rte
# AF_ROLE=

# ---------------------------------------------------------------------------------------------
# RTE (a container started with AF_ROLE=rte, which runs the playbooks)
# ---------------------------------------------------------------------------------------------

# how the RTE talks to the app : outbound (it dials APP_URL), inbound (the app dials RTE_URL),
# or database (deprecated, removed in 8.0.0)
# RTE_MODE=inbound
# the bearer token between the app and the RTE, at least 16 characters ; the app keeps the same
# token in the RTE credential of its runner
# RTE_TOKEN=change-me-at-least-16-characters
# outbound : the app's address as people open it ; inbound : where it registers itself once
# APP_URL=https://forms.example.com
# inbound : the address the app dials the RTE on
# RTE_URL=http://rte.example.com:8000
# a join token (afj_...) that approves the RTE at once, the first time ; else an admin approves it
# RTE_JOIN_TOKEN=afj_change-me
# the runner name the RTE joins as (default : its node id, which changes with the container)
# RTE_NAME=rte
# transfer (the app sends the job's files) or local (the RTE's own mounted folders)
# RTE_FILES=transfer
# read by the app : the largest folder it sends an RTE with RTE_FILES=transfer, in MB
# RTE_FILES_MAX_MB=512
# where the RTE keeps the folders the app sent
# RTE_CACHE_PATH=/path/to/persistent/rte-files
# the system's own proxy : an outbound RTE dials the app through it unless the app's host is in
# NO_PROXY, and a playbook keeps both
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,.example.com
