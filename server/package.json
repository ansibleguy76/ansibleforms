{
  "name": "ansible-forms",
  "version": "6.3.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/ansibleguy76/ansibleforms.git"
  },
  "description": "The nodejs backend for the ansible forms web applications",
  "scripts": {
    "start": "NODE_ENV=production node ./",
    "dev": "NODE_ENV=development nodemon --watch src --watch schema --watch config ./index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint ."
  },
  "dependencies": {
    "@outlinewiki/passport-azure-ad-oauth2": "~0.1.0",
    "ajv": "~8.20.0",
    "axios": "~1.19.0",
    "bcrypt": "~6.0.0",
    "cert-info": "~1.5.1",
    "connect-history-api-fallback": "~2.0.0",
    "cookie-session": "~2.1.1",
    "core-js": "~3.50.0",
    "cors": "~2.8.6",
    "croner": "~10.0.1",
    "dayjs": "~1.11.21",
    "dotenv": "~17.4.2",
    "express": "~5.2.1",
    "fs-extra": "~11.4.0",
    "helmet": "~8.3.0",
    "json-bigint": "~1.0.0",
    "ldap-authentication": "~4.0.4",
    "ldapts": "~9.0.0",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "moment": "~2.30.1",
    "moment-timezone": "0.6.3",
    "mongodb": "~7.5.0",
    "mssql": "~12.7.0",
    "multer": "~2.2.0",
    "mysql2": "~3.23.3",
    "node-cache": "~5.1.2",
    "node-jq": "~6.3.1",
    "nodemailer": "~9.0.5",
    "openid-client": "^6.8.4",
    "oracledb": "~7.0.1",
    "passport": "~0.7.0",
    "passport-http": "~0.3.0",
    "passport-jwt": "~4.0.1",
    "pg": "~8.23.0",
    "read-last-lines": "~1.10.0",
    "shell-quote": "1.10.0",
    "swagger-ui-express": "~5.0.1",
    "thenby": "~1.4.1",
    "winston": "~3.19.0",
    "winston-daily-rotate-file": "~5.0.0",
    "winston-syslog": "~2.7.1",
    "yaml": "~2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "~10.8.1",
    "globals": "^17.9.0",
    "nodemon": "~3.1.14",
    "vitest": "^4.1.10"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "off"
    }
  },
  "author": "ansibleguy",
  "license": "GPL"
}
