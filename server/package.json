{
  "name": "ansible-forms",
  "version": "6.3.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git://github.com/ansibleguy76/ansibleforms.git"
  },
  "description": "The nodejs backend for the ansible forms web applications",
  "scripts": {
    "start": "NODE_ENV=production node ./",
    "dev": "NODE_ENV=development nodemon --watch src --watch schema --watch config ./index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint ."
  },
  "dependencies": {
    "@outlinewiki/passport-azure-ad-oauth2": "~0.1.0",
    "ajv": "~8.20.0",
    "axios": "~1.18.1",
    "bcrypt": "~6.0.0",
    "cert-info": "~1.5.1",
    "connect-history-api-fallback": "~2.0.0",
    "cookie-session": "~2.1.1",
    "core-js": "~3.49.0",
    "cors": "~2.8.6",
    "croner": "~10.0.1",
    "dayjs": "~1.11.21",
    "dotenv": "~17.4.2",
    "express": "~5.2.1",
    "fs-extra": "~11.3.6",
    "helmet": "~8.2.0",
    "json-bigint": "~1.0.0",
    "ldap-authentication": "~4.0.4",
    "ldapts": "~8.1.8",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "moment": "~2.30.1",
    "moment-timezone": "0.6.2",
    "mongodb": "~7.4.0",
    "mssql": "~12.7.0",
    "multer": "~2.2.0",
    "mysql2": "~3.22.6",
    "node-cache": "~5.1.2",
    "node-jq": "~6.3.1",
    "nodemailer": "~9.0.3",
    "openid-client": "^6.8.4",
    "oracledb": "~6.10.0",
    "passport": "~0.7.0",
    "passport-http": "~0.3.0",
    "passport-jwt": "~4.0.1",
    "pg": "~8.22.0",
    "read-last-lines": "~1.8.0",
    "shell-quote": "1.9.0",
    "swagger-ui-express": "~5.0.1",
    "thenby": "~1.4.1",
    "winston": "~3.19.0",
    "winston-daily-rotate-file": "~5.0.0",
    "winston-syslog": "~2.7.1",
    "yaml": "~2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "~10.6.0",
    "globals": "^17.7.0",
    "nodemon": "~3.1.14",
    "vitest": "^4.1.10"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "off"
    }
  },
  "author": "ansibleguy",
  "license": "GPL"
}
