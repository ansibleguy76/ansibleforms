# The variables of compose.yaml : copy this file to .env and replace every change-me.
# The app nodes and the workers read all of it (env_file: .env) ; the RTE only RTE_TOKEN, which
# compose.yaml hands it, so it never holds the database's passwords.

# the database the app nodes and the workers share
DB_HOST=db
DB_PORT=3306
# a user with rights on the AnsibleForms schema only (the db container creates it), not root
DB_USER=ansibleforms
DB_PASSWORD=change-me
# the database server's own root, for its administration ; AnsibleForms never uses it
DB_ROOT_PASSWORD=change-me-too
# the same on every app node and worker : credentials stored by one must decrypt on all
ENCRYPTION_SECRET=change-me-32-characters-or-more
# the same on every app node : a token signed by one must be accepted by all
ACCESS_TOKEN_SECRET=change-me-a-long-random-string
# the RTE's bearer token (at least 16 characters) : the RTE reads it, and the config seed puts
# the same token in the RTE credential its runner signs in with (seed.yaml)
RTE_TOKEN=change-me-at-least-16-characters
# the config seed the worker applies at every start : the RTE's runner (seed.yaml)
CONFIG_SEED_PATH=/app/dist/seed/seed.yaml
# the app nodes serve plain http behind the load balancer
HTTPS=0
# each container's own log, NOT on the shared volume : several processes rotating one file
# lose lines (the default is persistent/logs, which every container here shares)
LOG_PATH=/app/dist/logs
